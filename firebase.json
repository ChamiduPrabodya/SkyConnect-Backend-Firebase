{
  "functions": [{
    "source": "functions",
    "codebase": "skyconnect",
    "runtime": "nodejs22",
    "ignore": ["node_modules", ".git", "*-debug.log", ".env.example", "test", "README.md"],
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run check"]
  }],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "functions": { "port": 5001 },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "auth": {
      "port": 9099
    },
    "storage": {
      "port": 9199
    }
  },
  "storage": {
    "rules": "storage.rules"
  }
}
