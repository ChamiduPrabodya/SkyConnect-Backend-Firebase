GOOGLE_CLOUD_PROJECT=skyconnect-sl-e4cdd
# Comma-separated Auth UIDs. Each must still have admin:true at send time.
NOTIFICATION_ADMIN_UIDS=YOUR_ADMIN_AUTH_UID
NOTIFICATION_POLL_MS=60000
FIREBASE_STORAGE_BUCKET=skyconnect-sl-e4cdd.firebasestorage.app
# The local launcher reads only CLOUDINARY_* from the AI backend .env.
# Set this explicitly in a deployed worker once its Cloudinary credentials exist.
# PUBLIC_MEDIA_PROVIDER=cloudinary
# Only if older photos really exist in a Firebase Storage bucket:
# LEGACY_FIREBASE_STORAGE_BUCKET=your-existing-bucket
